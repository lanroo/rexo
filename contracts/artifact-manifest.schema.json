{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rexo.dev/v0.1/artifact-manifest.schema.json",
  "title": "REXO Artifact Manifest",
  "description": "Describes one immutable, content-addressed output. Artifacts are never overwritten; a new input fingerprint yields a new artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "media_type",
    "size_bytes",
    "produced_by",
    "inputs_fingerprint",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "task_id", "capability"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[0-9A-Za-z_-]{8,64}$" },
        "task_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
        }
      }
    },
    "inputs_fingerprint": {
      "type": "string",
      "description": "sha256 over the capability plus resolved inputs. Two tasks with the same fingerprint must produce the same artifact, which enables replay and future caching.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
