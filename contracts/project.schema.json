{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rexo.dev/v0.1/project.schema.json",
  "title": "REXO Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "budget", "context", "quality"],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "created_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_calls", "max_seconds"],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "layers"],
      "properties": {
        "strategy": {
          "const": "minimum-necessary"
        },
        "layers": {
          "type": "array",
          "prefixItems": [
            { "const": "global" },
            { "const": "project" },
            { "const": "execution" },
            { "const": "task" }
          ],
          "items": false
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "max_attempts"],
      "properties": {
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
