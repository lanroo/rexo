{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rexo.dev/v0.1/capability.schema.json",
  "title": "REXO Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "input_schema", "output_schema"],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "enum": ["none", "filesystem-read", "filesystem-write", "network-read", "external-write"]
      },
      "uniqueItems": true,
      "default": ["none"]
    },
    "quality_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
